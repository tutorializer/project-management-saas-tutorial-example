    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.168.56",
    "@tutorializer/react": "https://github.com/tutorializer/react/archive/d7b1b2194d2baa22f457da71063697a6304348ce.tar.gz",
    "@tutorializer/tours": "https://github.com/tutorializer/tours/archive/d2f7fa3a4dc49bb73a3d744643a409aa7c3c22f9.tar.gz",
    "ky": "1.14.3",
    "msw": "2.15.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hot-toast": "2.6.1",
    "redaxios": "0.5.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.13.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "8.3.0"
  }
