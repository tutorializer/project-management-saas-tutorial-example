{
  "name": "project-management-saas-tutorial-example",
  "version": "1.0.0",
  "private": true,
  "description": "A self-contained project-management SaaS used to demonstrate Tutorializer product tutorials",
  "license": "MIT",
  "repository": "github:tutorializer/project-management-saas-tutorial-example",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "vite build && npm run typecheck",
    "dev": "vite dev",
    "preview": "vite preview",
    "start": "vite preview",
    "tutorializer:project": "npx --yes tutorializer@1.2.1 projects read bbc9cb5930cca72ee27329ff",
    "tutorials:record": "node tutorials/record.mjs",
    "tutorials:test": "playwright test --config tutorials/playwright.config.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@tanstack/react-query": "5.103.1",
    "@tanstack/react-query-devtools": "5.103.1",
