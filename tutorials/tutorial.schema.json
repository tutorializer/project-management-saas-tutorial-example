{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tutorializer.com/schemas/browser-tutorial.json",
  "title": "Tutorializer browser tutorial",
  "type": "object",
  "required": ["name", "title", "startPath", "viewport", "steps"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 1 },
    "startPath": { "type": "string", "pattern": "^/" },
    "viewport": {
      "type": "object",
      "required": ["width", "height"],
      "additionalProperties": false,
      "properties": {
        "width": { "type": "integer", "minimum": 320 },
        "height": { "type": "integer", "minimum": 320 }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["step", "action", "selector", "description"],
        "additionalProperties": false,
        "properties": {
          "step": { "type": "integer", "minimum": 1 },
          "action": {
            "enum": ["assert", "click", "drag", "highlight", "type", "wait"]
          },
          "selector": { "type": "string", "minLength": 1 },
          "endSelector": { "type": "string", "minLength": 1 },
          "value": { "type": "string" },
          "description": { "type": "string", "minLength": 1 },
          "pause": { "type": "integer", "minimum": 0 },
          "waitFor": { "type": "string", "minLength": 1 }
        },
        "allOf": [
          {
            "if": { "properties": { "action": { "const": "drag" } } },
            "then": { "required": ["endSelector"] }
          },
          {
            "if": { "properties": { "action": { "const": "type" } } },
            "then": { "required": ["value"] }
          }
        ]
      }
    }
  }
}
